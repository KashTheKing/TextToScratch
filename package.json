{
  "name": "texttoscratch",
  "version": "0.1.0",
  "description": "Write Scratch games in typed TypeScript and compile them to real Scratch blocks (.sb3).",
  "bin": {
    "tts": "dist/cli.js"
  },
  "files": [
    "dist",
    "lib"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsx --test test/compiler.test.ts test/engine.test.ts test/decompile.test.ts",
    "typecheck": "tsc -p .",
    "dev": "node scripts/serve.mjs",
    "tts": "tsx src/cli.ts"
  },
  "keywords": [
    "scratch",
    "typescript",
    "compiler",
    "sb3"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "jszip": "^3.10.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.57.0",
    "scratch-render": "^2.2.84",
    "scratch-storage": "^6.2.1",
    "scratch-vm": "^5.0.300",
    "tsx": "^4.23.15"
  }
}
